HOST=127.0.0.1
PORT=7676
# Owner password generated by `devspace init` in ~/.devspace/auth.json. Set this
# only for non-interactive or fully env-driven deployments.
# DEVSPACE_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret
# Optional OAuth tuning.
# DEVSPACE_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# DEVSPACE_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# DEVSPACE_OAUTH_SCOPES=devspace
# DEVSPACE_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1
DEVSPACE_ALLOWED_ROOTS=/home/you/projects
# For temporary tunnels, prefer setting this per run. DevSpace derives the
# inbound Host allowlist from this URL.
# DEVSPACE_PUBLIC_BASE_URL=https://your-public-host.example.com
# Advanced escape hatch. `*` disables Host header allowlist protection.
# DEVSPACE_ALLOWED_HOSTS=localhost,127.0.0.1,your-public-host.example.com
# oauth | secure-tunnel. secure-tunnel requires loopback-only HOST.
# DEVSPACE_AUTH_MODE=secure-tunnel
# minimal | full | codex
DEVSPACE_TOOL_MODE=full
# off | changes | full. Defaults to changes.
# changes creates one aggregate review widget via review_changes instead of per-tool iframes.
DEVSPACE_WIDGETS=changes
DEVSPACE_LOG_LEVEL=info
DEVSPACE_LOG_FORMAT=json
DEVSPACE_LOG_REQUESTS=1
DEVSPACE_LOG_ASSETS=0
DEVSPACE_LOG_TOOL_CALLS=1
DEVSPACE_LOG_SHELL_COMMANDS=0
# DEVSPACE_TRUST_PROXY=1
# DEVSPACE_STATE_DIR=/home/you/.local/share/devspace
# DEVSPACE_WORKTREE_ROOT=/home/you/.devspace/worktrees
# Native-file download is opt-in. Files stream to a model-selected relative
# path inside an already-open workspace without overwriting existing files.
# DEVSPACE_ARTIFACTS=1
# DEVSPACE_ARTIFACT_MAX_FILE_BYTES=104857600
# DEVSPACE_AUTO_LOAD_AGENTS_MD=1
# Skills are enabled by default. Set DEVSPACE_SKILLS=0 to hide them.
# DEVSPACE_SKILLS=0
# DEVSPACE_AGENT_DIR=/home/you/.codex
# DEVSPACE_SKILL_PATHS=/home/you/.codex/skills,/home/you/.claude/skills

# DevPilot local supervisor. The Control Center stays on a separate localhost
# listener while it starts/stops the MCP server, agent daemon, and managed tunnel.
# DEVPILOT_CONTROL_HOST=127.0.0.1
# DEVPILOT_CONTROL_PORT=7680
# DEVPILOT_AUTOSTART=1
# none | external | cloudflare-quick | openai-secure | managed-command
# DEVPILOT_TUNNEL_PROVIDER=openai-secure
# OpenAI Secure MCP Tunnel settings. Keep the runtime key out of committed files.
# DEVPILOT_OPENAI_TUNNEL_CLIENT=tunnel-client
# DEVPILOT_OPENAI_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef
# DEVPILOT_OPENAI_TUNNEL_API_KEY=sk-...
# DEVPILOT_OPENAI_TUNNEL_HEALTH_ADDR=127.0.0.1:7683
# Optional proxy used only for tunnel-client -> OpenAI control-plane traffic.
# DEVPILOT_OPENAI_CONTROL_PLANE_PROXY=http://127.0.0.1:YOUR_PROXY_PORT
# CONTROL_PLANE_HTTP_PROXY=http://127.0.0.1:YOUR_PROXY_PORT
# Cloudflare Quick Tunnel fallback.
# DEVPILOT_CLOUDFLARED=cloudflared
# For managed-command tunnels, the process is spawned directly without a shell.
# DEVPILOT_TUNNEL_COMMAND=your-tunnel-command
# DEVPILOT_TUNNEL_ARGS_JSON=["arg1","arg2"]
# DEVPILOT_TUNNEL_PUBLIC_BASE_URL=https://mcp.example.com
